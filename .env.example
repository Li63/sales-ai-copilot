# 企业微信基础配置
WECHAT_CORP_ID=企业CorpID
WECHAT_AGENT_ID=自建应用AgentId
WECHAT_APP_SECRET=自建应用Secret
WECHAT_ARCHIVE_SECRET=会话存档Secret
WECHAT_PUBLIC_KEY_VER=公钥版本号
WECHAT_RSA_PRIVATE_KEY=/run/secrets/wecom_private_key.pem
WECHAT_TRUSTED_DOMAIN=https://your-domain.example.com

# 会话存档 SDK：local/stub 不拉取，production 下接入 Linux Finance SDK
ARCHIVE_CLIENT=stub
WECOM_FINANCE_SDK_PATH=/opt/wecom/libWeWorkFinanceSdk_C.so

# 文本分析模型：用于最终销售分析、话术、复盘、指南输出
LLM_API_KEY=DeepSeek API密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 图片识别模型：只用于 OCR / 图片理解，识别结果会转成纯文本再交给 DeepSeek 分析
VISION_API_KEY=阿里云百炼 DashScope API Key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
PRODUCT_KNOWLEDGE=请在这里填写产品知识库摘要

# 数据库配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=sales_agent

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

ENVIRONMENT=local
